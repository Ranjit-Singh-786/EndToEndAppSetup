# ==============================================================================
# Database Configuration (MySQL & MongoDB)
# ==============================================================================

# MySQL root password (used by MySQL container)
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# MySQL Connection Details for services
# Note: In Docker Compose, the host is 'mysql'. For local runs, set to 'localhost'.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_root_password

# Isolated MySQL databases for each service (enforces database ownership)
MYSQL_USERS_DB=smartfarm_users
MYSQL_FARMS_DB=smartfarm_farms

# MongoDB Connection Details for monitoring service
# Note: In Docker Compose, the host is 'mongodb'. For local runs, set to 'localhost'.
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_DATABASE=smartfarm_monitoring

# ==============================================================================
# Service to Service Communication URLs
# ==============================================================================
# Used inside Docker. For local run, use http://localhost:8001, etc.
# The gateway-service (browser UI on port 3000) uses these same URLs to
# compose its server-rendered pages.
USER_SERVICE_URL=http://user-service:8001
FARM_SERVICE_URL=http://farm-service:8002
MONITORING_SERVICE_URL=http://monitoring-service:8003
